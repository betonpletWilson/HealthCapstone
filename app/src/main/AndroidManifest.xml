<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="com.fitwizard.fitwizard">


    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/fitwizard_foreground"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/fitwizard_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.FitWizard"
        tools:targetApi="31" >

        <activity android:name="Login_Register.LoginActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name="Login_Register.RegisterActivity" />
        <activity android:name=".HomeActivity" />
        <activity android:name="Goals.GoalsActivity" />
        <activity android:name="Goals.AddEditGoalActivity" />
        <activity android:name="Medication.AddEditMedicationActivity" />
        <activity android:name="Medication.MedicationActivity" />




        <!-- Define the HomeActivity as the main entry point -->
    <activity android:name="Recipe_Logging.FoodLogActivity" />
        <activity android:name=".ProfileActivity" />
        <activity android:name="Recipe_Logging.FoodSearchActivity" />
        <activity android:name="Mood.MoodActivity" />
        <activity android:name="Mood.MoodJournalActivity" />

        <receiver android:name="Goals.GoalReminderReceiver"
            android:exported="true" />


    </application>

</manifest>