<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Outer circle -->
    <item>
        <shape android:shape="oval">
            <stroke
                android:width="1dp"
                android:color="#FF9BB8" />
            <size
                android:width="36dp"
                android:height="36dp" />
        </shape>
    </item>

    <!-- Inner circle (slightly smaller) -->
    <item
        android:left="4dp"
        android:top="4dp"
        android:right="4dp"
        android:bottom="4dp">
        <shape android:shape="oval">
            <stroke
                android:width="1dp"
                android:color="#FF9BB8" />
            <size
                android:width="28dp"
                android:height="28dp" />
        </shape>
    </item>
</layer-list>
