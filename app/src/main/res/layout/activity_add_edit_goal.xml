<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white"
    android:orientation="vertical"
    android:padding="24dp">

    <!-- Top App Bar -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@android:color/white">

        <ImageButton
            android:id="@+id/backButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_back"
            android:contentDescription="Back"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:padding="12dp" />

        <TextView
            android:id="@+id/goalScreenTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Add Goal"
            android:textSize="20sp"
            android:textColor="@android:color/black"
            android:textStyle="bold"
            android:layout_centerInParent="true" />
    </RelativeLayout>

    <!-- Goal Name -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Goal Name"
        android:textColor="@android:color/black"
        android:layout_marginTop="16dp" />

    <EditText
        android:id="@+id/editTextGoalName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="e.g., 100 pushups"
        android:padding="12dp"
        android:background="@drawable/edittext_background" />

    <!-- Goal Deadline -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Goal Deadline"
        android:textColor="@android:color/black"
        android:layout_marginTop="16dp" />

    <Button
        android:id="@+id/buttonPickDeadline"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Pick Deadline Date"
        android:backgroundTint="@color/green"
        android:textColor="@android:color/white"
        android:layout_marginTop="4dp"/>

    <!-- Daily Reminder Section -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="16dp">

        <CheckBox
            android:id="@+id/checkBoxDailyReminder"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Daily Reminder" />

        <Button
            android:id="@+id/buttonPickReminderTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Pick Reminder Time"
            android:layout_marginStart="16dp"
            android:backgroundTint="@color/green"
            android:textColor="@android:color/white"/>
    </LinearLayout>

    <!-- Save Goal Button -->
    <Button
        android:id="@+id/buttonSaveGoal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Save Goal"
        android:textColor="@android:color/white"
        android:backgroundTint="@color/green"
        android:layout_marginTop="32dp"/>

</LinearLayout>
